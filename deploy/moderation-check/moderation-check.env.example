# /etc/featurevote/moderation-check.env — install as 0600 root:root (systemd reads
# it as root; the featurevote service user never needs to).
# Read by featurevote-moderation-check.service in addition to /etc/featurevote/env
# (which provides FV_DATABASE_URL).

# Ping URL of the Okokumo cron check
#   "<product> FeatureVote — suggestions pending moderation >48h"
# schedule: cron `0 7 * * *`, timezone UTC, grace 1h.
# It contains the check's secret token: never commit or paste the real value.
FV_MODERATION_PING_URL=https://app.okokumo.com/ping/<token>

# Admin page printed in the alert so the reader knows where to moderate (optional, not secret).
FV_MODERATION_ADMIN_URL=https://feedback.okokumo.com/admin
