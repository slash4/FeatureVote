# FeatureVote service configuration (see docs/INTEGRATION.md section 7).
# Generate secrets with: openssl rand -hex 32

FV_DATABASE_URL=postgres://featurevote:featurevote@localhost:5432/featurevote?sslmode=disable
# Shared with the host product as FEATURE_VOTE_SECRET. >= 32 bytes.
FV_HOST_SECRET=
# Expected "iss" claim, e.g. okokumo or doloop.
FV_HOST_ISSUER=okokumo
# Admin API / admin page token. >= 32 bytes, different from FV_HOST_SECRET.
FV_ADMIN_TOKEN=
# Origins allowed to call /v1/* from browsers (comma-separated, exact).
FV_ALLOWED_ORIGINS=https://app.okokumo.com,https://okokumo.com

# Optional (defaults shown)
FV_LISTEN_ADDR=:8080
FV_SUBMIT_LIMIT_PER_DAY=5
FV_VOTE_LIMIT_PER_MINUTE=30
FV_CLOCK_SKEW=30s
FV_COOKIE_SECURE=true
# Peers whose X-Forwarded-For is trusted (admin login throttle); "none" to disable.
FV_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Tests / scripts
# FV_TEST_DATABASE_URL=postgres://featurevote:featurevote@localhost:5432/featurevote_test?sslmode=disable
